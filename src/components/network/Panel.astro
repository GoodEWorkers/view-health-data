---
import { DEPARTMENTS } from '../../content/departments.ts';
import type { DepartmentId } from '../../content/departments.ts';
import { FLOW_ENTRIES } from '../../figures/hospital-floor/network/sheets.ts';

type Props = { room: DepartmentId };

const { room } = Astro.props;
const entries = FLOW_ENTRIES.filter((entry) => entry.room === room);
const targetOf = ({ flow, external }: (typeof entries)[number]): string => {
  if (external && 'partner' in flow) return flow.partner;
  return 'to' in flow ? (DEPARTMENTS.find(({ id }) => id === flow.to)?.acronym ?? flow.to) : '';
};
---

<div class="trace">
  <h4>Fiches de flux</h4>
  <ul class="trace-flows">
    {
      entries.map((entry) => (
        <li>
          <button type="button" class="trace-button" data-open-flow={entry.key}>
            <strong>{targetOf(entry)}</strong>
            {entry.flow.payload}
          </button>
        </li>
      ))
    }
  </ul>
  <div class="trace-actions">
    <button type="button" class="trace-action" data-open-view="rules">Table de règles</button>
    <button type="button" class="trace-action" data-open-view="partners">Partenaires externes</button>
    <button type="button" class="trace-action" data-open-view="glossary">Glossaire</button>
  </div>
</div>

<style>
  h4 {
    margin: 1rem 0 0.25rem;
    color: var(--anatomy-muted);
    font-family: var(--anatomy-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .trace-flows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trace-button {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    width: 100%;
    padding: 0.25rem 0.375rem 0.25rem 0;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--anatomy-text);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
    transition: background-color 120ms var(--anatomy-ease);
  }

  .trace-button strong {
    color: var(--anatomy-strong);
    font-weight: 500;
  }

  .trace-button::after {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    margin: 0 0.25rem 0.1rem 0.5rem;
    border: solid var(--anatomy-text);
    border-width: 1.5px 1.5px 0 0;
    transform: rotate(45deg);
  }

  .trace-button:hover,
  .trace-button[data-current] {
    background: color-mix(in srgb, var(--room) 12%, var(--anatomy-paper));
    color: var(--anatomy-strong);
  }

  .trace-button:focus-visible,
  .trace-action:focus-visible {
    outline: 1px solid var(--anatomy-muted);
    outline-offset: 2px;
  }

  .trace-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
  }

  .trace-action {
    padding: 0.4rem 0.625rem;
    border: 1px solid var(--anatomy-mid);
    border-radius: 0.35rem;
    background: var(--anatomy-face);
    color: var(--anatomy-strong);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    transition:
      background-color 120ms var(--anatomy-ease),
      border-color 120ms var(--anatomy-ease);
  }

  .trace-action:hover {
    border-color: var(--anatomy-strong);
    background: color-mix(in srgb, var(--room) 12%, var(--anatomy-face));
  }

  @media (pointer: coarse) {
    .trace-action,
    .trace-button {
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trace-button,
    .trace-action {
      transition: none;
    }
  }
</style>
