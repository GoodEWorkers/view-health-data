---
import { DEPARTMENTS } from '../../content/departments.ts';
import type { DepartmentId } from '../../content/departments.ts';
import { FLOW_ENTRIES, zoneLook } from '../../figures/hospital-floor/network/sheets.ts';

type Props = { room: DepartmentId };

const { room } = Astro.props;
const entries = FLOW_ENTRIES.filter((entry) => entry.room === room);
const targetOf = ({ flow, external }: (typeof entries)[number]): string => {
  if (external && 'partner' in flow) return flow.partner;
  return 'to' in flow ? (DEPARTMENTS.find(({ id }) => id === flow.to)?.acronym ?? flow.to) : '';
};
---

<div class="trace">
  <h4>Fiches de flux</h4>
  <ul class="trace-flows">
    {
      entries.map((entry) => (
        <li>
          <button type="button" class="trace-button" data-open-flow={entry.key}>
            <strong>{targetOf(entry)}</strong>
            {entry.flow.payload}
          </button>
        </li>
      ))
    }
  </ul>
  <div class="trace-actions">
    <button type="button" class="trace-action" data-open-view="rules">Table de règles</button>
    <button type="button" class="trace-action" data-open-view="partners">Partenaires externes</button>
    <button type="button" class="trace-action" data-open-view="glossary">Glossaire</button>
  </div>
</div>
<div class="trace-dock" data-trace-panel>
    <h4>Trajet d'un flux</h4>
    <p class="trace-hint" data-trace-hint>Survolez un câble du plan, ou un flux de la liste : son trajet s'affiche ici, étape par étape.</p>
    {
      entries.map(({ key, sheet }) => (
        <ol class="trace-hops" data-trace={key} hidden>
          {
            sheet.hops.map(({ label, zone }) => {
              const look = zoneLook(zone);
              return (
                <li style={`--zone: ${look.colour}`}>
                  <i></i>
                  <span>
                    <strong>{label}</strong>
                    <small>{look.label}</small>
                  </span>
                </li>
              );
            })
          }
        </ol>
      ))
    }
</div>

<style>
  h4 {
    margin: 1rem 0 0.25rem;
    color: var(--anatomy-muted);
    font-family: var(--anatomy-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (min-width: 721px) {
    .trace-dock {
      position: sticky;
      bottom: 0;
    }
  }

  .trace-dock {
    max-height: 60vh;
    margin-top: 1rem;
    padding: 0 0 0.5rem;
    overflow-y: auto;
    background: var(--anatomy-paper);
    border-top: 1px solid var(--anatomy-faint);
    box-shadow: 0 -10px 12px -10px color-mix(in srgb, var(--anatomy-strong) 22%, transparent);
  }

  .trace-hint {
    margin: 0.25rem 0 0;
    color: var(--anatomy-text);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .trace-hops {
    display: grid;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .trace-hops[hidden] {
    display: none;
  }

  .trace-hops li {
    position: relative;
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.25rem 0.375rem 0.375rem 0;
    border-radius: 0.35rem;
    font-size: 0.875rem;
    line-height: 1.35;
    transition: background-color 120ms var(--anatomy-ease);
  }

  .trace-hops li::before {
    content: '';
    position: absolute;
    top: 1.15rem;
    bottom: -0.2rem;
    left: 0.4375rem;
    width: 1px;
    background: var(--anatomy-lo);
  }

  .trace-hops li:last-child::before {
    display: none;
  }

  .trace-hops i {
    width: 0.625rem;
    height: 0.625rem;
    margin: 0.3rem 0 0 0.125rem;
    border-radius: 50%;
    background: var(--zone);
    box-shadow:
      0 0 0 2px var(--anatomy-paper),
      0 0 0 3px color-mix(in srgb, var(--zone) 55%, var(--anatomy-paper));
  }

  .trace-hops strong {
    display: block;
    color: var(--anatomy-strong);
    font-weight: 600;
  }

  .trace-hops small {
    color: color-mix(in srgb, var(--zone) 55%, var(--anatomy-strong));
    font-size: 0.75rem;
  }

  .trace-hops li[data-here] {
    background: color-mix(in srgb, var(--zone) 16%, var(--anatomy-paper));
  }

  .trace-flows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trace-button {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr);
    width: 100%;
    padding: 0.25rem 0.375rem 0.25rem 0;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--anatomy-text);
    font: inherit;
    font-size: 0.875rem;
    line-height: 1.4;
    text-align: left;
    cursor: pointer;
    transition: background-color 120ms var(--anatomy-ease);
  }

  .trace-button strong {
    color: var(--anatomy-strong);
    font-weight: 500;
  }

  .trace-button:hover,
  .trace-button[data-current] {
    background: color-mix(in srgb, var(--room) 12%, var(--anatomy-paper));
    color: var(--anatomy-strong);
  }

  .trace-button:focus-visible,
  .trace-action:focus-visible {
    outline: 1px solid var(--anatomy-muted);
    outline-offset: 2px;
  }

  .trace-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 1rem;
  }

  .trace-action {
    padding: 0.4rem 0.625rem;
    border: 1px solid var(--anatomy-mid);
    border-radius: 0.35rem;
    background: var(--anatomy-face);
    color: var(--anatomy-strong);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    transition:
      background-color 120ms var(--anatomy-ease),
      border-color 120ms var(--anatomy-ease);
  }

  .trace-action:hover {
    border-color: var(--anatomy-strong);
    background: color-mix(in srgb, var(--room) 12%, var(--anatomy-face));
  }

  @media (pointer: coarse) {
    .trace-action,
    .trace-button {
      min-height: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trace-hops li,
    .trace-button,
    .trace-action {
      transition: none;
    }
  }
</style>
