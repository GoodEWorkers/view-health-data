---
import { FLOW_ENTRIES, zoneLook } from '../../figures/hospital-floor/network/sheets.ts';
---

<div class="trace-dock" data-trace-panel>
  <h4>Trajet d'un flux</h4>
  <p class="trace-hint" data-trace-hint>Survolez un câble du plan : son trajet s'affiche ici, étape par étape.</p>
  {
    FLOW_ENTRIES.map(({ key, sheet }) => (
      <ol class="trace-hops" data-trace={key} hidden>
        {
          sheet.hops.map(({ label, zone }) => {
            const look = zoneLook(zone);
            return (
              <li style={`--zone: ${look.colour}`}>
                <i />
                <span>
                  <strong>{label}</strong>
                  <small>{look.label}</small>
                </span>
              </li>
            );
          })
        }
      </ol>
    ))
  }
</div>

<style>
  .trace-dock {
    display: none;
    flex: none;
    height: var(--trace-dock-height, 15rem);
    padding: 0 1.5rem;
    overflow-y: auto;
    background: color-mix(in srgb, var(--anatomy-strong) 3%, var(--anatomy-paper));
    border-top: 1px solid var(--anatomy-faint);
  }

  :global(.layout[data-layer='reseau']) .trace-dock {
    display: block;
  }

  h4 {
    margin: 0.75rem 0 0.25rem;
    color: var(--anatomy-muted);
    font-family: var(--anatomy-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .trace-hint {
    margin: 0.25rem 0 0;
    color: var(--anatomy-text);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .trace-hops {
    display: grid;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .trace-hops[hidden] {
    display: none;
  }

  .trace-hops li {
    position: relative;
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.5rem;
    padding: 0.125rem 0.375rem 0.25rem 0;
    border-radius: 0.35rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    transition: background-color 120ms var(--anatomy-ease);
  }

  .trace-hops li::before {
    content: '';
    position: absolute;
    top: 1rem;
    bottom: -0.2rem;
    left: 0.4375rem;
    width: 1px;
    background: var(--anatomy-lo);
  }

  .trace-hops li:last-child::before {
    display: none;
  }

  .trace-hops i {
    width: 0.625rem;
    height: 0.625rem;
    margin: 0.2rem 0 0 0.125rem;
    border-radius: 50%;
    background: var(--zone);
    box-shadow:
      0 0 0 2px var(--anatomy-paper),
      0 0 0 3px color-mix(in srgb, var(--zone) 55%, var(--anatomy-paper));
  }

  .trace-hops span {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
  }

  .trace-hops strong {
    color: var(--anatomy-strong);
    font-weight: 600;
  }

  .trace-hops small {
    color: color-mix(in srgb, var(--zone) 55%, var(--anatomy-strong));
    font-size: 0.72rem;
  }

  .trace-hops li[data-here] {
    background: color-mix(in srgb, var(--zone) 16%, var(--anatomy-paper));
  }

  @media (max-width: 720px) {
    .trace-dock {
      height: auto;
      min-height: var(--trace-dock-height, 15rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trace-hops li {
      transition: none;
    }
  }
</style>
