---
import { DEFAULT_LAYER, LAYERS } from '../content/layers.ts';
---

<div class="layers" role="tablist" aria-label="Couches d'information">
  {
    LAYERS.map(({ id, label }) => (
      <button
        type="button"
        role="tab"
        class="layer-tab"
        id={`layer-tab-${id}`}
        aria-selected={id === DEFAULT_LAYER ? 'true' : 'false'}
        tabindex={id === DEFAULT_LAYER ? 0 : -1}
      >
        {label}
      </button>
    ))
  }
</div>

<style>
  .layers {
    display: flex;
    gap: 2px;
    margin-bottom: 1.25rem;
    padding: 2px;
    border: 1px solid var(--anatomy-faint);
    border-radius: 0.5rem;
  }

  .layer-tab {
    flex: 1 1 auto;
    padding: 0.4rem 0.2rem;
    border: 0;
    border-radius: 0.35rem;
    background: transparent;
    color: var(--anatomy-muted);
    font: inherit;
    font-size: 0.75rem;
    line-height: 1.3;
    white-space: nowrap;
    cursor: pointer;
  }

  .layer-tab:hover {
    color: var(--anatomy-strong);
  }

  .layer-tab[aria-selected='true'] {
    background: var(--anatomy-strong);
    color: var(--anatomy-paper);
  }

  .layer-tab:focus-visible {
    outline: 1px solid var(--anatomy-muted);
    outline-offset: 2px;
  }

  @media (pointer: coarse) {
    .layer-tab {
      min-height: 2.75rem;
    }
  }
</style>
