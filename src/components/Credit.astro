---
import logoSvg from '../assets/goodeworkers.svg?raw';
---

<div class="credit">
  <a class="badge" href="https://goodeworkers.org" target="_blank" rel="noopener" aria-label="Créé par Richard Raduly pour Good eWorkers">
    <span class="logo" role="img" aria-label="Good eWorkers" set:html={logoSvg} />
    <span class="text"><span>Créé par Richard Raduly</span> <span>pour Good eWorkers</span></span>
  </a>
</div>

<style>
  /* The brand allows the logo only on #111111 or white, 110 px wide at least; the header asks for 96 px. */
  .credit {
    --credit-ground: #111111;
    --credit-text: #e0e0e0;
    flex: none;
  }

  .badge {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.75rem 0.375rem 0.625rem;
    background: var(--credit-ground);
    border-radius: 0.5rem;
    color: var(--credit-text);
    font-size: 0.72rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .badge:hover .text {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .badge:focus-visible {
    outline: 2px solid var(--anatomy-strong);
    outline-offset: 2px;
  }

  .logo {
    flex: none;
    width: 96px;
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .text span {
    display: block;
    white-space: nowrap;
  }

  @media (max-width: 1099px) {
    .badge {
      padding: 0.375rem 0.5rem;
    }

    .text {
      display: none;
    }
  }
</style>
