---
import logoSvg from '../assets/goodeworkers.svg?raw';
---

<footer class="credit">
  <a class="badge" href="https://goodeworkers.org" target="_blank" rel="noopener">
    <span class="logo" role="img" aria-label="Good eWorkers" set:html={logoSvg} />
    <span class="text"><span>Créé par</span> <span>Richard Raduly</span> <span>pour Good eWorkers</span></span>
  </a>
</footer>

<style>
  /* The logo's own brand rule: only on #111111 or white, 110 px wide at least. */
  .credit {
    --credit-ground: #111111;
    --credit-text: #e0e0e0;
    flex: none;
    padding: 0.5rem;
  }

  .badge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    padding: 0.625rem;
    background: var(--credit-ground);
    border-radius: 0.75rem;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--credit-ground) 30%, transparent),
      0 6px 14px -4px color-mix(in srgb, var(--credit-ground) 45%, transparent);
    color: var(--credit-text);
    font-size: 0.8rem;
    line-height: 1.3;
    text-decoration: none;
  }

  .badge:hover .text {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .badge:focus-visible {
    outline: 2px solid var(--anatomy-strong);
    outline-offset: 2px;
  }

  .logo {
    flex: none;
    width: 120px;
  }

  .logo :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Beside the logo while its longest chunk fits (min-content), else under it. */
  .text {
    flex: 1 1 0;
  }

  .text span {
    white-space: nowrap;
  }
</style>
