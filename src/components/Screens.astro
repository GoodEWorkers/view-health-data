---
import './screens.css';
import './skeleton.css';
import './skeletonViews.css';
import './editor.css';
import { DEPARTMENTS } from '../content/departments.ts';
import { VIEW_BOX } from '../figures/hospital-floor/camera.ts';
import { LIFTED_RECTS, quadOfRect, startQuadOf } from '../figures/hospital-floor/screens/lift.ts';
import { wireLabelsSvg, wiresSvg } from '../figures/hospital-floor/screens/wireMarkup.ts';
import { wiresIn } from '../figures/hospital-floor/screens/wires.ts';
import Inspector from './Inspector.astro';
import ScreenWindow from './ScreenWindow.astro';
import Bloc from './screens/bloc.astro';
import Dpi from './screens/dpi.astro';
import Eai from './screens/eai.astro';
import Gam from './screens/gam.astro';
import PacsRis from './screens/pacs-ris.astro';
import Pharmacie from './screens/pharmacie.astro';
import Rdv from './screens/rdv.astro';
import Sgl from './screens/sgl.astro';

const wires = wiresIn(VIEW_BOX);
const lineColours = DEPARTMENTS.map(({ id, colour, textColour }) => `--line-${id}:${colour};--text-${id}:${textColour}`).join(';');
const contents = { gam: Gam, rdv: Rdv, dpi: Dpi, sgl: Sgl, 'pacs-ris': PacsRis, pharmacie: Pharmacie, bloc: Bloc, eai: Eai };
const cornersOf = (quad: readonly (readonly [number, number])[]): string => quad.map(([x, y]) => `${x.toFixed(2)},${y.toFixed(2)}`).join(' ');
const countOf = (id: string, side: 'source' | 'target'): number => wires.filter((wire) => wire[side] === id).length;
---

<div class="screens" data-screens data-view={`${VIEW_BOX.width} ${VIEW_BOX.height}`} style={lineColours}>
  <svg class="wires" aria-hidden="true" set:html={wiresSvg(wires)} />
  {DEPARTMENTS.map(({ id }) => <div class="screen-shadow" data-shadow={id} hidden></div>)}
  {
    DEPARTMENTS.map(({ id }) => {
      const Content = contents[id];
      return (
        <ScreenWindow id={id} outgoing={countOf(id, 'source')} incoming={countOf(id, 'target')} start={cornersOf(startQuadOf(id))} end={cornersOf(quadOfRect(LIFTED_RECTS[id]))}>
          <Content />
        </ScreenWindow>
      );
    })
  }
  <svg class="wire-labels" aria-hidden="true" set:html={wireLabelsSvg(wires)} />
  <Inspector />
</div>

<script>
  import '../figures/hospital-floor/screens/screensLive.ts';
</script>
