---
import { DEPARTMENTS } from '../content/departments.ts';
import type { DepartmentId } from '../content/departments.ts';
import { plainName } from '../content/layerLabels.ts';
import { EDITOR_FILES } from '../content/messages/index.ts';
import { LOGICAL, socketCentre } from '../figures/hospital-floor/screens/jackWires.ts';
import Editor from './Editor.astro';

type Props = {
  id: DepartmentId;
  outgoing: number;
  incoming: number;
  start: string;
  end: string;
};

const { id, outgoing, incoming, start, end } = Astro.props;
const { acronym, colour, textColour, softwareExamples } = DEPARTMENTS.find((department) => department.id === id)!;
const product = plainName(softwareExamples[0]!);
const sockets = [
  ...Array.from({ length: outgoing }, (_, slot) => socketCentre(slot, outgoing, 'bottom')),
  ...Array.from({ length: incoming }, (_, slot) => socketCentre(slot, incoming, 'top')),
];
---

<section
  class="screen"
  data-window={id}
  data-room={id}
  data-start={start}
  data-end={end}
  role="group"
  aria-label={`Écran de ${acronym} : ${product}`}
  style={`--room: ${colour}; --room-text: ${textColour}; width: ${LOGICAL.width}px; height: ${LOGICAL.height}px`}
  data-content="skeleton"
  hidden
>
  <div class="screen-frame">
    <div class="screen-glass" aria-hidden="true">
      <header class="screen-title">
        <span class="screen-product">{product}</span>
        <span class="screen-system">{acronym}</span>
        <span class="screen-loading">Chargement…</span>
        <span class="screen-progress"></span>
      </header>
      <div class="screen-body"><slot /></div>
      <Editor file={EDITOR_FILES[id]} acronym={acronym} />
    </div>
    {sockets.map(([x, y]) => <i class="socket" style={`left: ${x}px; top: ${y}px`} />)}
  </div>
</section>
