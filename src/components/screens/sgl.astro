---
import { LAB_RESULTS, LAB_STATUS } from '../../content/screenMocks.ts';
---

<div class="sk-table" style="--columns: 1.5fr 0.8fr 0.9fr 1.2fr 0.35fr">
  <span class="sk-head">Analyse</span><span class="sk-head sk-end">Résultat</span><span class="sk-head">Unité</span><span class="sk-head">Référence</span><span class="sk-head"></span>
  {LAB_RESULTS.map(({ analysis, value, unit, reference, flag }) => (
    <>
      <span class:list={['sk-cell', flag && 'sk-strong']}>{analysis}</span>
      <span class:list={['sk-cell', 'sk-end', 'sk-mono', flag && 'sk-strong']}>{value}</span>
      <span class="sk-cell sk-muted">{unit}</span>
      <span class="sk-cell sk-mono sk-muted">{reference}</span>
      <span class="sk-cell">{flag && <span class="sk-flag">{flag}</span>}</span>
    </>
  ))}
</div>
<p class="sk-footnote">{LAB_STATUS}</p>
