---
import '@fontsource-variable/atkinson-hyperlegible-next/wght.css';
import '../iso/iso.css';
import MobileNotice from '../components/MobileNotice.astro';

type Props = {
  title: string;
  fullscreen?: boolean;
};

const { title, fullscreen = false } = Astro.props;
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="iso" data-theme="light" data-fullscreen={fullscreen}>
    <slot name="header" />
    <main data-fullscreen={fullscreen}>
      <slot />
    </main>
    <MobileNotice />
  </body>
</html>

<style is:global>
  html {
    color-scheme: light;
  }

  body {
    margin: 0;
    background: var(--anatomy-page);
    color: var(--anatomy-text);
    font-family: 'Atkinson Hyperlegible Next Variable', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.7;
  }

  main {
    max-width: 72rem;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  main[data-fullscreen] {
    max-width: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 721px) {
    body[data-fullscreen] {
      display: flex;
      flex-direction: column;
      height: 100dvh;
    }

    main[data-fullscreen] {
      flex: 1 1 0;
      min-height: 0;
    }
  }

  h1 {
    color: var(--anatomy-strong);
  }
</style>
